ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
# People the bot answers: comma-separated Name=+E164[/uuid], e.g. Keith=+16175550100,Alex=+16175550101/<uuid>
USERS=
# The bot's own Signal number (the Tello SIM), E.164
BOT_NUMBER=
# Optional: the bot's own Signal uuid (ACI), so group checks recognise the bot if signal-cli lists it by uuid
BOT_UUID=
DEFAULT_AGENT=pi
